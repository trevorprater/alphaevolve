# Example environment variables for AlphaEvolve LLM providers
# Copy this file to .env and add your actual API keys
# Usage: cp .env.example .env

# ============================================================================
# LLM Provider API Keys
# ============================================================================

# OpenAI API Configuration (for o4, o3, o1, GPT-4 models)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic API Configuration (for Claude 4, Claude 3.5 models)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Configuration (for Gemini 2.5 models via API)
GOOGLE_API_KEY=your_google_api_key_here

# Google Cloud Vertex AI Configuration (for Gemini via Google Cloud)
# Note: Vertex AI uses Application Default Credentials (ADC)
# Run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
GOOGLE_CLOUD_LOCATION=us-central1

# ============================================================================
# Optional: Custom Base URLs (for enterprise/local deployments)
# ============================================================================

# OPENAI_BASE_URL=https://your-custom-openai-endpoint.com/v1
# ANTHROPIC_BASE_URL=https://your-custom-anthropic-endpoint.com/v1

# ============================================================================
# Optional: Additional Configuration
# ============================================================================

# Environment (development, staging, production)
# ALPHAEVOLVE_ENV=development

# Log level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
# LOG_LEVEL=INFO

# Enable metrics collection
# ENABLE_METRICS=false
